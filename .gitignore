# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js build output & cache (never commit this)
/.next/
/.next-*/
/out/
*.tsbuildinfo

# Production
/build
/dist

# Environment variables & local secrets
.env
.env*.local

# SQLite Database files (generated locally via prisma)
prisma/*.db
prisma/*.db-journal

# Temporary files & logs
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Agentation local temporary files
agentation-dev.html

# Raw Asset Archives from Drive/Folder (1.8GB)
CIM WEB/

# User uploads generated at runtime
public/uploads/*
!public/uploads/.gitkeep

# Exclude video files (GitHub blocks files > 100MB without Git LFS)
*.mp4
*.webm

# Runtime user data (profile pictures)
/storage/

# Local database backups (contain emails and password hashes)
/backups/
