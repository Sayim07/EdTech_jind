generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled runtime connection
  directUrl = env("DIRECT_URL")   // used by prisma migrate / db push
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String
  avatarUrl    String?
  googleId     String?      @unique
  role         String       @default("STUDENT") // "STUDENT" | "ADMIN"
  // Student profile (see lib/profile.ts for which of these are required before a purchase)
  dob          DateTime?
  gender       String?
  phone        String?
  education    String?      // highest level: "High school", "Bachelor's degree", ...
  institution  String?
  qualification String?     // degree or field of study
  skills       String[]
  interests    String[]
  occupation   String?
  address      String?
  city         String?
  state        String?
  pin          String?
  country      String?
  onboardingSeenAt DateTime? // set once the welcome popup has been shown, so it never repeats
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  enrollments  Enrollment[]
  submissions  Submission[]
  progress     LessonProgress[]
  resetTokens  PasswordResetToken[]
  mcqAttempts  McqAttempt[]
  payments     Payment[]
  staffProfile StaffMember?
  examVerifications ExamVerification[]
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique // sha256 of the emailed token; the raw token is never stored
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id               String       @id @default(uuid())
  title            String
  slug             String       @unique
  description      String
  shortDescription String?
  thumbnail        String?
  price            Float        @default(0.0)
  originalPrice    Float?
  level            String       @default("All Levels") // "Beginner" | "Intermediate" | "Advanced" | "All Levels"
  category         String       @default("History & Food")
  instructorName   String       @default("CIM India Faculty")
  instructorId     String?      // the Staff member who teaches it. Without one, course messages go to the admins
  instructor       StaffMember? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  published        Boolean      @default(true)
  featured         Boolean      @default(false)
  totalHours       Float?       // optional override; otherwise computed from lesson durations
  faqs             String?      // JSON: [{ "q": string, "a": string }]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  modules          Module[]
  enrollments      Enrollment[]
  mcqTests         McqTest[]
  payments         Payment[]
}

model Module {
  id        String   @id @default(uuid())
  title     String
  order     Int      @default(1)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  assignments Assignment[]
  tests     McqTest[]
}

model Lesson {
  id             String       @id @default(uuid())
  title          String
  slug           String
  order          Int          @default(1)
  type           String       @default("VIDEO") // "VIDEO" | "YOUTUBE" | "PPT" | "PDF" | "ASSIGNMENT"
  videoUrl       String?      // Local relative or streaming path
  fileUrl        String?      // PPTX / PDF local or remote path
  audioUrl       String?      // M4A / Audio podcast track
  infographicUrl String?      // High-res summary infographic image
  duration       String?      // e.g. "14:20"
  content        String?      // Markdown or notes
  moduleId       String
  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  progress    LessonProgress[]
}

model LessonProgress {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Assignment {
  id           String       @id @default(uuid())
  title        String
  description  String
  instructions String?
  attachments  String?      // JSON: [{ "name": string, "url": string }]
  maxScore     Int          @default(100)
  order        Int          @default(1)
  moduleId     String?      // assignments live inside a module (MCQ assignments are McqTest rows with kind ASSIGNMENT)
  module       Module?      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonId     String?      // legacy: older assignments were attached to a lesson
  lesson       Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  submissions  Submission[]

  @@index([moduleId])
}

model Submission {
  id           String     @id @default(uuid())
  userId       String
  assignmentId String
  content      String?
  fileUrl      String?
  status       String     @default("PENDING") // "PENDING" | "SUBMITTED" | "GRADED"
  score        Int?
  feedback     String?
  submittedAt  DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  courseId   String
  amountPaid Float    @default(0.0)
  paymentId  String?
  status     String   @default("ACTIVE") // "ACTIVE" | "COMPLETED"
  completedAt     DateTime?
  certificateCode String?  @unique // issued once every lesson is completed
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// A test or MCQ assignment belongs to a course OR a module, never both (enforced by a CHECK constraint in the database).
model McqTest {
  id           String        @id @default(uuid())
  courseId     String?       // course-level (standalone) test
  moduleId     String?       // module-level test or MCQ assignment
  kind         String        @default("TEST") // "TEST" | "ASSIGNMENT" (assignments are only allowed inside a module)
  title        String
  timeLimit    Int           @default(30) // minutes
  passingMarks Int           @default(50) // percent
  allowRetakes Boolean       @default(true)
  // Exam controls (proctoring). The defaults keep existing tests behaving as before.
  requireCamera      Boolean   @default(true)   // random still photos during the exam (no video, nothing recorded)
  requireIdCheck     Boolean   @default(false)  // selfie + ID card photo, approved by a teacher/admin, before the first attempt
  requireConsent     Boolean   @default(true)   // camera and monitoring notice the student must accept
  accessCode         String?                    // when set, the student must type it to start
  startsAt           DateTime?                  // exam window: cannot start before this
  endsAt             DateTime?                  // cannot start after this, and a running attempt is cut off at this time
  questionCount      Int?                       // draw this many questions from the bank (all when empty)
  randomizeQuestions Boolean   @default(true)
  randomizeOptions   Boolean   @default(true)
  maxViolations      Int       @default(3)      // counted violations before the attempt is submitted automatically
  captureEverySeconds Int      @default(120)    // one random photo inside every window of this length
  photoRetentionDays Int       @default(30)     // ID photos and captures are deleted this many days after being taken
  order        Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module       Module?       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions    McqQuestion[]

  @@index([moduleId])
}

model McqQuestion {
  id            String  @id @default(uuid())
  testId        String
  order         Int     @default(1)
  text          String
  options       String  // JSON: string[4] (A-D); blank entries are unused
  correctIndex  Int
  explanation   String?
  test          McqTest @relation(fields: [testId], references: [id], onDelete: Cascade)
}

// One attempt of a real test (testKey = McqTest.id) or of the built-in sample test (testKey = "sample-<courseId>").
// Questions are snapshotted so history stays accurate after the admin edits the test.
model McqAttempt {
  id             String    @id @default(uuid())
  userId         String
  courseId       String
  testKey        String
  testTitle      String
  timeLimit      Int
  passingMarks   Int
  questions      String    // JSON snapshot incl. correct answers (never sent to the client while in progress)
  answers        String    @default("{}") // JSON: { [questionId]: optionIndex }
  status         String    @default("IN_PROGRESS") // "IN_PROGRESS" | "SUBMITTED"
  score          Int?
  total          Int?
  percentage     Float?
  passed         Boolean?
  violations     Int       @default(0)
  autoSubmitted  Boolean   @default(false)
  autoReason     String?   // "TIME_UP" | "PROCTORING"
  snapshots      String    @default("[]") // legacy: JSON [{ t, img: data URL }]. New attempts store captures in object storage (ProctorCapture)
  deadlineAt     DateTime?  // the server's own end time for this attempt. The browser clock is never used for the timer
  sessionHash    String?    // hash of the token held by the one tab/device that currently owns this attempt
  sessionLastSeenAt DateTime? // last heartbeat of that tab
  sessionDevice  String?
  consentAt      DateTime?
  verificationId String?
  reviewStatus   String    @default("PENDING") // "PENDING" | "VALID" | "SUSPICIOUS" (set by a teacher/admin)
  reviewNote     String?
  reviewedById   String?
  reviewedAt     DateTime?
  mediaPurgedAt  DateTime?
  events         ProctorEvent[]
  captures       ProctorCapture[]
  startedAt      DateTime  @default(now())
  submittedAt    DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, testKey])
  @@index([courseId])
}

// One checkout attempt for a paid course, through any gateway. Amounts are stored in the smallest currency unit (paise).
// The server sets the amount from Course.price; the browser never decides what is charged.
model Payment {
  id               String    @id @default(uuid())
  userId           String
  courseId         String
  gateway          String    // "razorpay" (more gateways plug in via lib/payments)
  gatewayOrderId   String?   @unique
  gatewayPaymentId String?   @unique
  amount           Int       // paise
  currency         String    @default("INR")
  status           String    @default("CREATED") // "CREATED" | "PAID" | "FAILED"
  failureReason    String?
  method           String?   // "upi" | "card" | "netbanking" | "wallet" | "emi" | ... as reported by the gateway
  methodDetail     String?   // e.g. "Visa credit card ending 4242", "UPI: name@bank", "HDFC Bank"
  gatewayFee       Int?      // paise charged by the gateway (incl. tax), when reported
  paidAt           DateTime?
  originalAmount   Int?      // paise, before any coupon
  discountAmount   Int       @default(0) // paise taken off by the coupon
  couponId         String?
  couponCode       String?   // kept even if the coupon is later deleted
  billing          Json?     // name, email, phone, address, city, state, pin, country
  refundedAmount   Int       @default(0) // paise refunded so far
  note             String?   // e.g. a duplicate payment that needs a refund
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  refunds          Refund[]
  coupon           Coupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  redemption       CouponRedemption?

  @@index([userId, courseId])
  @@index([createdAt])
  @@index([couponId])
}

// A discount code. Empty courseIds / allowedEmails mean "everyone".
model Coupon {
  id            String   @id @default(uuid())
  code          String   @unique // always stored upper case
  description   String?
  type          String   // "PERCENT" | "FIXED"
  value         Float    // percent (1-100) or rupees
  maxDiscount   Float?   // rupee cap for percent coupons
  minOrder      Float?   // rupee minimum course price
  startsAt      DateTime?
  expiresAt     DateTime?
  maxUses       Int?     // across all students
  perUserLimit  Int      @default(1)
  active        Boolean  @default(true)
  courseIds     String[] // one course, or several (a bundle). Empty = every course
  allowedEmails String[] // a student group. Empty = every student
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payments      Payment[]
  redemptions   CouponRedemption[]
}

// One use of a coupon. RESERVED while the payment is open, REDEEMED once paid, RELEASED if it failed or was refunded in full.
model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  paymentId String   @unique
  amount    Int      // paise discounted
  status    String   @default("RESERVED")
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

model Refund {
  id              String    @id @default(uuid())
  paymentId       String
  amount          Int       // paise
  status          String    @default("PENDING") // "PENDING" | "PROCESSED" | "FAILED"
  reason          String?
  gatewayRefundId String?   @unique
  failureReason   String?
  createdBy       String?   // admin user id
  createdAt       DateTime  @default(now())
  processedAt     DateTime?
  payment         Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([createdAt])
}

// Course categories, created and managed by admins. Courses keep the category name as a plain label.
model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
}

// People who teach or run the academy. This is a directory managed by admins, not a login account.
model StaffMember {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  phone       String?
  role        String   @default("INSTRUCTOR") // "INSTRUCTOR" | "STAFF"
  designation String?  // e.g. "Culinary Historian", "Student Support Lead"
  bio         String?
  active      Boolean  @default(true)
  userId      String?  @unique // the login account, once an admin gives this person access (role INSTRUCTOR)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  courses     Course[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Identity check before an exam: a live selfie and a photo of the front of the ID card, kept in PRIVATE object storage.
model ExamVerification {
  id           String    @id @default(uuid())
  userId       String
  testKey      String
  courseId     String
  selfieKey    String?   // object storage keys (set to null once the retention period has passed)
  idKey        String?
  status       String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  rejectReason String?
  reviewedById String?
  reviewedAt   DateTime?
  consentAt    DateTime?
  purgeAfter   DateTime
  purgedAt     DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, testKey])
  @@index([courseId, status])
  @@index([purgeAfter])
}

// Everything suspicious that happened during an attempt, with the server's own timestamp.
model ProctorEvent {
  id        String     @id @default(uuid())
  attemptId String
  type      String     // TAB_HIDDEN | WINDOW_BLUR | FULLSCREEN_EXIT | COPY | PASTE | CUT | CONTEXT_MENU | PRINT | SHORTCUT | CAMERA_LOST | FACE_MISSING | MULTIPLE_FACES | SESSION_CONFLICT | OFFLINE | AUTO_SUBMIT | NOTE
  at        DateTime   @default(now())
  clientAt  DateTime?
  detail    String?
  counted   Boolean    @default(false) // counted towards the exam's violation limit
  attempt   McqAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, at])
}

// A still photo taken at a random moment. Stored in private object storage; never video.
model ProctorCapture {
  id         String     @id @default(uuid())
  attemptId  String
  key        String?
  takenAt    DateTime   @default(now())
  faceCount  Int?       // from the in-browser face check, when it ran. A hint for the reviewer, never a verdict
  purgeAfter DateTime
  purgedAt   DateTime?
  attempt    McqAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, takenAt])
  @@index([purgeAfter])
}

// A teacher/admin lets one student take an exam again.
model ExamRetakeGrant {
  id          String    @id @default(uuid())
  userId      String
  testKey     String
  courseId    String
  reason      String?
  grantedById String
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, testKey])
}
