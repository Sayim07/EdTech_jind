# Required in production: a long random string used to sign login sessions.
JWT_SECRET=

# Public URL of the site (used in password reset emails and Google sign-in redirects).
APP_URL=http://localhost:3000

# Payments: Razorpay (https://dashboard.razorpay.com/app/keys). Use rzp_test_ keys in development, rzp_live_ in production.
# The secret is only ever read on the server; the browser gets the key id from the create-order API.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks. URL: <APP_URL>/api/payments/webhook/razorpay
# Events: payment.captured, payment.failed, order.paid. Paste the secret you choose there.
RAZORPAY_WEBHOOK_SECRET=

# Google sign-in (https://console.cloud.google.com/apis/credentials, "OAuth client ID", type "Web application").
# Add this Authorized redirect URI:  <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password reset emails via Resend (https://resend.com). Without these, reset links are printed in the server console.
RESEND_API_KEY=
MAIL_FROM="CIM India <no-reply@your-domain.com>"

# Database: Supabase Postgres. Rotate the password in Supabase before production, then update both URLs.
# DATABASE_URL = transaction pooler (port 6543) used by the running app.
# DIRECT_URL   = session pooler (port 5432) used by prisma migrate and the scripts in /scripts.
# Use the pooler hosts (Connection > Connection pooling in the dashboard); the db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Supabase Storage (profile pictures only). service_role bypasses RLS: server-only, never NEXT_PUBLIC_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars
